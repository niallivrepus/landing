{
  "name": "gooey-workspace",
  "displayName": "Gooey",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter gooey dev",
    "build": "pnpm --filter gooey build",
    "fmt": "prettier --cache --write --log-level=warn \"**/*.{ts,tsx,md,json}\"",
    "fmt:check": "prettier --cache --check --log-level=warn \"**/*.{ts,tsx,md,json}\"",
    "check-types": "pnpm --filter @jokuh/gooey check-types",
    "import:decor:v1llains": "node ./scripts/import-v1llains-decor.mjs",
    "swift:sync": "node ./scripts/convert-gooey-swift.mjs --all-supported",
    "swift:list": "node ./scripts/convert-gooey-swift.mjs --list",
    "swift:build": "swift build --package-path swift/GooeySwift",
    "swift:check": "node ./scripts/check-gooey-swift.mjs"
  },
  "devDependencies": {
    "hugeicons-react": "0.3.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.42.2",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
