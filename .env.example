# Free inference: https://console.groq.com — used by Vite dev/preview middleware at POST /api/site-search
GROQ_API_KEY=
RESEND_API_KEY=
CONTACT_SALES_TO_EMAIL=hello@jokuh.com
CONTACT_SALES_FROM_EMAIL=Jokuh <hello@jokuh.com>
CONTACT_SALES_WEBHOOK_URL=
# Optional local fallback when testing without Resend. Do not use in production.
# CONTACT_SALES_DEV_MODE=log
VITE_CONTACT_SALES_ENDPOINT=
# Local dev: Vite middleware POST /api/story-submissions. Optional: persist to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias of service role (same as above)
# SUPABASE_SERVICE_KEY=
# VITE_STORY_SUBMISSIONS_ENDPOINT=
# (defaults to /api/story-submissions)
VITE_ORIGIN_DEVELOPERS=
VITE_ORIGIN_HELP=https://help.jokuh.com
VITE_ORIGIN_STATUS=https://status.jokuh.com
# VITE_ORIGIN_APP=https://app.jokuh.com

# Cookie/analytics wiring. Use .jokuh.com in production if consent should persist across subdomains.
VITE_COOKIE_DOMAIN=
VITE_GA_MEASUREMENT_ID=

# ElevenLabs TTS for newsroom "Listen to article". Server-side key, never exposed to the browser.
# The middleware caches generated MP3s under public/article-audio/<hash>.mp3 so each
# (voice, model, article-text) tuple costs the API exactly once.
ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=tMXujoAjiboschVOhAnk
VITE_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
