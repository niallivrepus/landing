# Railway deploy checklist: docs/railway-deployment.md
# Free inference: https://console.groq.com — used by Vite dev/preview middleware and Railway server at POST /api/site-search
GROQ_API_KEY=
RESEND_API_KEY=
CONTACT_SALES_TO_EMAIL=sean@sierri.com
CONTACT_SALES_FROM_EMAIL=Jokuh <sean@sierri.com>
CONTACT_SALES_WEBHOOK_URL=
# Optional local fallback when testing without Resend. Do not use in production.
# CONTACT_SALES_DEV_MODE=log
VITE_CONTACT_SALES_ENDPOINT=
# Local dev: Vite middleware POST /api/story-submissions. Optional: persist to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias of service role (same as above)
# SUPABASE_SERVICE_KEY=
# VITE_STORY_SUBMISSIONS_ENDPOINT=
# (defaults to /api/story-submissions)
VITE_ORIGIN_DEVELOPERS=
VITE_ORIGIN_HELP=https://help.jokuh.com
VITE_ORIGIN_STATUS=https://status.jokuh.com
# VITE_ORIGIN_APP=https://app.jokuh.com

# Public Blurbs feed on /blurbs — server route GET /api/public-blurbs-feed proxies sitemap + RPC.
# Browser cannot call blurbs-sitemap Edge directly (no CORS); Vite middleware (local dev) + server/railway.ts (Railway) handle it.
# Defaults match `Config/JokuhSupabase.xcconfig` when unset (anon/publishable key only — never service role).
VITE_SUPABASE_URL=https://iyrpplpvggsdsubwmudw.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_TV6S_N2Zp2bE6ew3U1LPKg_iiCMMam3
# Optional on Railway: direct Storage signing (faster). Without it, avatars use the
# `public-identity-avatar` Supabase Edge function (deploy from `backend/supabase/functions/`).
# Still required for blurb media thumbnails (private blurbs-media bucket).
SUPABASE_SERVICE_ROLE_KEY=
# Optional client override (defaults to /api/public-blurbs-feed)
# VITE_PUBLIC_BLURBS_FEED_ENDPOINT=/api/public-blurbs-feed

# Profile people search on /profile — server route GET /api/public-people-search proxies search_accounts RPC.
# Requires SUPABASE_SERVICE_ROLE_KEY on Railway (RPC is authenticated-only; never expose service role to the browser).
# VITE_PUBLIC_PEOPLE_SEARCH_ENDPOINT=/api/public-people-search

# Profile demo pod on /profile — GET /api/public-profile-demo loads peek_public_profile + network preview.
# Uses VITE_SUPABASE_ANON_KEY for peek/blurbs; SUPABASE_SERVICE_ROLE_KEY enables avatar signing + network peers.
# VITE_PUBLIC_PROFILE_DEMO_ENDPOINT=/api/public-profile-demo

# Cookie/analytics wiring. Use .jokuh.com in production if consent should persist across subdomains.
VITE_COOKIE_DOMAIN=
VITE_GA_MEASUREMENT_ID=

# GoDaddy (no root CNAME): forward jokuh.com → www.jokuh.com and set www here so Railway does not 308 back to apex.
# Cloudflare / root CNAME: omit or set apex (default).
# LANDING_CANONICAL_HOST=www

# ElevenLabs TTS for newsroom "Listen to article". Server-side key, never exposed to the browser.
# The middleware caches generated MP3s under public/article-audio/<hash>.mp3 so each
# (voice, model, article-text) tuple costs the API exactly once.
ELEVENLABS_API_KEY=
VITE_ELEVENLABS_VOICE_ID=tMXujoAjiboschVOhAnk
VITE_ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
